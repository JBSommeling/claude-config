# block-cpu-load.cases — table for block-cpu-load.test.sh
# Format: expect<TAB>command. expect is deny, ask or allow. "#" starts a comment.
# \n, \r and \t in a command become a literal newline, carriage return and tab.
# Commands are only ever sent to the hook as JSON text. They are never executed.

# ===== migrated: stress tools =====
deny	stress --cpu 8 --timeout 60
deny	stress-ng --cpu 4
deny	sudo stress-ng --cpu 4
deny	nohup stress --cpu 2 &
deny	nice -n 10 stress --cpu 2
deny	timeout 30 stress-ng --cpu 2
deny	echo start && stress --cpu 1
deny	make build; stress --cpu 1
deny	true || stress-ng --cpu 1
deny	ls | stress --cpu 1
deny	(stress --cpu 1)
deny	/usr/bin/stress --cpu 1

# ===== migrated: yes to /dev/null =====
deny	yes > /dev/null
deny	yes >/dev/null &
deny	yes y > /dev/null
deny	yes   >   /dev/null
deny	for n in 1 2 3 4; do yes > /dev/null & done

# ===== migrated: fork bombs =====
deny	:(){ :|:& };:
deny	:() { : | : & } ; :
deny	bomb(){ bomb|bomb& };bomb
deny	bomb ( ) {  bomb | bomb &  } ; bomb

# ===== migrated: empty busy loops =====
deny	while true; do :; done
deny	while :; do :; done
deny	while true; do true; done
deny	while [ 1 ]; do :; done
deny	for ((;;)); do :; done
deny	until false; do :; done
deny	while true;do :;done
deny	while  true;  do  :;  done &
deny	while true\ndo\n  :\ndone

# ===== migrated: dd =====
deny	dd if=/dev/zero of=/dev/null
deny	dd if=/dev/urandom of=/dev/null
deny	dd of=/dev/null if=/dev/zero
deny	dd if=/dev/zero bs=1m of=/dev/null
deny	dd if=/dev/urandom of=/dev/null bs=1m count=100000000

# ===== migrated: hash and compress burners =====
deny	cat /dev/urandom | gzip > /dev/null
deny	cat /dev/zero | xz > /dev/null
deny	cat /dev/urandom | md5sum > /dev/null
deny	cat /dev/urandom > /dev/null
deny	md5 < /dev/zero
deny	sha256sum /dev/zero
deny	shasum -a 256 /dev/urandom
deny	md5sum /dev/urandom

# ===== migrated: benchmarks =====
deny	openssl speed
deny	openssl speed -multi 8 rsa2048
deny	sysbench cpu run
deny	sysbench --test=cpu run
deny	sysbench --threads=8 cpu run

# ===== migrated: inline interpreter loops =====
deny	python -c "while True: pass"
deny	python3 -c "while 1: pass"
deny	python3 -c 'while True:  pass'
deny	node -e 'while(true){}'
deny	node -e 'while (1) { }'
deny	node -e 'for(;;){}'
deny	perl -e 'while(1){}'
deny	perl -e '1 while 1'
deny	ruby -e 'while(true){}'
deny	ruby -e 'for ( ; ; ) {}'
deny	npm test -- -c ci && cat /dev/urandom > /dev/null
deny	ls -n ; sha256sum /dev/zero
deny	head -5 file.txt; cat /dev/urandom | gzip > /dev/null

# ===== migrated: allowed legitimate loops =====
allow	while true; do curl -s localhost:8080/health; sleep 5; done
allow	while ! pg_isready; do sleep 1; done
allow	while true; do :; sleep 1; done
allow	until false; do sleep 2; done
allow	for n in 1 2 3; do echo "$n"; done

# ===== migrated: allowed lookalikes and ordinary commands =====
allow	yes | apt-get install foo
allow	yes | some-installer
allow	git log --grep stress
allow	git log --grep=stress-ng
allow	grep stress file.txt
allow	cat stress-notes.md
allow	vim stress-test.md
allow	echo I felt stressed today
allow	npm test
allow	make -j8
allow	cargo build --release
allow	head -c 100 /dev/urandom | base64
allow	head -c 1000 /dev/urandom | md5
allow	dd if=/dev/zero of=disk.img bs=1m count=10
allow	python3 -c "print(1)"
allow	node -e "console.log(1)"
allow	openssl rand -hex 16
allow	openssl s_client -connect example.com:443
allow	sysbench fileio run
allow	cat /dev/urandom | head -c 10 | gzip > /dev/null
allow	npm test && head -c 100 /dev/urandom | base64

# ===== audit 1: newlines keep command position =====
deny	echo hi\nstress --cpu 1
deny	ls\n\nstress-ng --cpu 2
deny	echo hi\r\nstress --cpu 1\r\n
deny	ls && \\nstress --cpu 1
deny	echo hi\n  yes > /dev/null
deny	echo hi\nk6 run x.js && stress --cpu 1
allow	echo hi\necho stress
allow	echo hi \\n stress-notes

# ===== audit 2: command position and wrappers =====
deny	bash -c "stress --cpu 1"
deny	sh -c 'stress --cpu 1'
deny	zsh -c 'stress --cpu 1'
deny	bash -lc 'echo hi; stress --cpu 1'
deny	/bin/bash -c "nice -n 5 stress --cpu 1"
deny	"stress" --cpu 1
deny	'stress-ng' --cpu 1
deny	st''ress --cpu 1
deny	st""ress-ng --cpu 1
deny	\stress --cpu 1
deny	echo `stress --cpu 1`
deny	echo $(stress --cpu 1)
deny	{ stress --cpu 1; }
deny	! stress --cpu 1
deny	FOO=1 stress --cpu 1
deny	A=1 B=2 stress --cpu 1
deny	env FOO=1 stress --cpu 1
deny	env -i FOO=1 stress --cpu 1
deny	env -u HOME stress --cpu 1
deny	/usr/bin/env FOO=1 /usr/local/bin/stress --cpu 1
deny	timeout -s KILL 30 stress --cpu 1
deny	timeout -k 5 30s stress --cpu 1
deny	timeout --signal=KILL 30 stress --cpu 1
deny	nice stress --cpu 1
deny	nice -10 stress --cpu 1
deny	nice -n -5 stress --cpu 1
deny	caffeinate -i stress --cpu 1
deny	caffeinate -t 60 -i stress --cpu 1
deny	taskpolicy -b stress --cpu 1
deny	echo 1 | xargs -n 1 stress --cpu
deny	echo 1 | xargs -I {} stress --cpu {}
deny	parallel stress --cpu ::: 1 2
deny	watch -n 5 stress --cpu 1
deny	sudo -u nobody stress --cpu 1
deny	sudo -E stress --cpu 1
deny	doas stress --cpu 1
deny	nohup nice -n 5 timeout 10 sudo stress --cpu 1
deny	exec stress --cpu 1
deny	command stress --cpu 1
deny	time stress --cpu 1
deny	eval stress --cpu 1
deny	eval "stress --cpu 1"
deny	if stress --cpu 1; then echo ok; fi
deny	for n in 1 2; do stress --cpu 1; done
deny	sudo sh -c "stress-ng --cpu 2"
allow	command -v stress
allow	command -v stress-ng
allow	which stress
allow	type stress
allow	man stress
allow	brew install stress
allow	apt-get install stress-ng
allow	env
allow	env FOO=1 echo stress
allow	timeout 30 echo stress
allow	sudo -u nobody ls /tmp
allow	bash -c "echo stress"

# ===== audit 3: only head, dd count= and pv -S are real size limits =====
deny	cat /dev/urandom | gzip -c > /dev/null
deny	cat /dev/urandom | gzip -n > /dev/null
deny	cat /dev/zero | xz -c > /dev/null
deny	cat /dev/zero | zstd -n > /dev/null
deny	cat /dev/urandom | md5sum -c > /dev/null
deny	cat /dev/urandom | bzip2 -n > /dev/null
allow	head -c 100 /dev/urandom | gzip -c > /dev/null
allow	cat /dev/urandom | head -n 100 | gzip -c > /dev/null
allow	cat /dev/zero | head --bytes=100 | gzip > /dev/null
allow	dd if=/dev/zero count=100 | gzip > /dev/null
allow	pv -S 100M < /dev/zero | gzip > /dev/null
allow	pv --stop-at-size -s 100M /dev/zero | xz > /dev/null

# ===== audit 4: burner forms that used to slip through =====
deny	gzip < /dev/zero > /dev/null
deny	xz < /dev/urandom > /dev/null
deny	openssl sha256 < /dev/zero
deny	openssl dgst -sha256 /dev/urandom
deny	yes | cat > /dev/null
deny	yes | gzip > /dev/null
deny	yes | md5sum
deny	yes y | pv > /dev/null
deny	node -e 'while(true);'
deny	node -e 'for(;;);'
deny	nodejs -e 'while (true) { x++ }'
deny	deno eval 'while(true){}'
deny	bun -e 'for(;;){}'
deny	ruby -e 'loop{}'
deny	ruby -e 'loop do end'
deny	ruby -e 'loop do x += 1 end'
deny	php -r 'while(true);'
deny	php -r 'while (1) { $x++; }'
deny	python3 -c 'while True: x=1'
deny	python -c 'while 1: x += 1'
deny	perl -e 'while(1){$x++}'
deny	perl -e 'for(;;){}'
allow	python3 -c 'import time\nwhile True: time.sleep(1)'
allow	python3 -c 'while True: input()'
allow	node -e 'setInterval(()=>{},1000)'
allow	node -e 'while(true){ await sleep(1) }'
allow	ruby -e 'loop { break }'
allow	php -r 'while(true){ sleep(1); }'
allow	python3 -c 'print(sum(range(10)))'
allow	ruby -e 'puts 1'
allow	php -r 'echo 1;'

# ===== audit 5: other mismatches found by reading the patterns =====
deny	sha256 /dev/zero
deny	sha512 < /dev/urandom
deny	cat /dev/random > /dev/null
deny	dd if=/dev/random of=/dev/null
deny	yes &> /dev/null
deny	yes >& /dev/null
deny	yes 1> /dev/null
deny	yes >> /dev/null
deny	yes > /dev/null 2>&1 &
deny	nohup yes >/dev/null 2>&1 &
deny	cat /dev/zero >/dev/null 2>&1
deny	function bomb { bomb | bomb & }; bomb
deny	.() { .|.& };.
allow	yes 2>/dev/null | head -n 1
allow	yes | apt-get install -y foo > /dev/null
allow	yes | apt-get install -y foo > /dev/null 2>&1
allow	cat /dev/zero 2>/dev/null | head -c 10
allow	ls 2>/dev/null
allow	cat notes.txt > /dev/null
allow	cmd 2>&1 | tee build.log
allow	foo() { bar | baz & }

# ===== new deny: inline interpreter loops need an exempt word to pass =====
deny	python3 -c "while True:\n    x = 1"
deny	python3.11 -c 'while True: pass'
deny	node -e "while(1){counter++}"
deny	perl -e '1 while 1'
deny	bun -e 'while(true){}'
allow	bun run dev
allow	node server.js
allow	node -e 'while(true){ if (done) break }'

# ===== new deny: unbounded parallelism =====
deny	make -j
deny	make -j -s
deny	make -j test
deny	make -j0
deny	make -j 0
deny	make --jobs
deny	make --jobs=0
deny	gmake -j
deny	xargs -P 0 echo
deny	xargs -P0 echo
deny	ls | xargs -n1 -P 0 echo
deny	ls | xargs --max-procs=0 echo
deny	parallel -j 0 echo ::: a b
deny	parallel -j0 echo ::: a b
deny	parallel --jobs 0 echo ::: a b
deny	sudo make -j
deny	cd build && make -j

