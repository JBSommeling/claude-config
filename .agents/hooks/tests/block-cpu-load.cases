# ===== known limitations (documented false denies and misses) =====
deny	echo "done; stress --cpu 1"
deny	git commit -m "fix\nstress --cpu notes"
deny	echo "a | stress --cpu 1"
allow	t=stress; $t --cpu 1
allow	echo c3RyZXNzIC0tY3B1IDEK | base64 -d | sh
allow	$'\x73tress' --cpu 1
